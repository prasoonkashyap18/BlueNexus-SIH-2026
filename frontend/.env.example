# BlueNexus frontend environment (D11)
#
# Copy to `.env.local` (git-ignored) to override a value for your machine:
#     cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Put NOTHING secret here — these values are inlined into the shipped JS.

# Base URL of the BlueNexus data API.
# Default when unset: http://localhost:8000  (see src/api/config.ts)
# For a production build, set this to the deployed backend's public URL, e.g.
#   VITE_API_BASE_URL=https://api.example.org
# It is inlined into the static bundle at build time.
VITE_API_BASE_URL=http://localhost:8000
